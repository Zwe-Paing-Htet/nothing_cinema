<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCustomerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ID • 1"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvCustomerUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="username"
        android:textColor="@color/nc_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCustomerEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="email@example.com"
        style="@style/TextAppearance.NothingCinema.BodySecondary" />

</LinearLayout>