<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Theatre"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Linked Cinema"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/cinemaNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cinema Name"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theatre Details"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/theatreNameEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Theatre name"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/theatreTypeEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Theatre type"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theatre Image"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/theatreImageView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder"
                android:contentDescription="Theatre Image" />

            <Button
                android:id="@+id/chooseImageButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="Choose Image" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:text="Save Theatre" />

    </LinearLayout>
</ScrollView>