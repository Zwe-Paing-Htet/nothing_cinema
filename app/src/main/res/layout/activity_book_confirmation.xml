<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmation"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/successMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Confirmed"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/infoMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please pay with cash at the cinema at least 2 hours before showtime or your booking may be canceled."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/movieValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theatre"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/theatreValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seats"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/seatsValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/totalValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nc_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/customerValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Showtime"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/showtimeValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booked At"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/bookedAtValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />
        </LinearLayout>

        <Button
            android:id="@+id/backToMainButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:text="Back to Main Page" />

    </LinearLayout>
</ScrollView>