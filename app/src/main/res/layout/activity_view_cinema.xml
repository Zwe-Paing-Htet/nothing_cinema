<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nc_black"
    android:paddingStart="24dp"
    android:paddingTop="70dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:layout_marginBottom="20dp"
        android:background="@android:color/transparent"
        android:contentDescription="Go back"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        android:tint="@color/nc_text_primary" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin"
        android:textColor="@color/nc_text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cinemas"
        style="@style/TextAppearance.NothingCinema.Display"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage cinema records and create linked theatres."
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/emptyCinemasTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No cinemas have been added yet."
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cinemaRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>