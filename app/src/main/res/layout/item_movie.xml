<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <ImageView
        android:id="@+id/moviePosterImageView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="14dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder" />

    <TextView
        android:id="@+id/movieNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movie Name"
        android:textColor="@color/nc_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/movieRuntimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="120 min"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/movieGenreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Action"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addShowtimeButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:layout_width="80dp"
            android:layout_weight="1"
            android:text="Add Showtime" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/editButton"
            style="@style/Widget.NothingCinema.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Edit" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.NothingCinema.Button.Danger"
            android:layout_width="wrap_content"
            android:text="Delete" />
    </LinearLayout>

</LinearLayout>