<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theatre"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:id="@+id/theatreImageView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="18dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_image_bg"
            android:clipToOutline="true"
            android:src="@drawable/ic_placeholder"
            android:contentDescription="Theatre Image" />

        <TextView
            android:id="@+id/theatreNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theatre Name"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/theatreTypeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/theatreCinemaNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cinema Name"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/theatreCinemaAddressTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cinema Address"
                style="@style/TextAppearance.NothingCinema.Meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/MovieNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Movies"
            style="@style/TextAppearance.NothingCinema.SectionTitle"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/movieContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>