<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <ImageView
        android:id="@+id/moviePosterImageView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginBottom="14dp"
        android:scaleType="fitCenter"
        android:background="@drawable/rounded_image_bg"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:src="@drawable/ic_placeholder"
        android:contentDescription="Movie Poster" />

    <TextView
        android:id="@+id/movieNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movie Name"
        android:textColor="@color/nc_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/movieRuntimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="120 min"
        android:textColor="@color/nc_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/movieGenreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Action"
        android:textColor="@color/nc_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bookButton"
            style="@style/Widget.NothingCinema.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Book" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/buyButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Buy" />
    </LinearLayout>

</LinearLayout>