<!--                android:layout_marginBottom="12dp" />-->

<!--            <Spinner-->
<!--                android:id="@+id/seatTypeSpinner"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:background="@drawable/bg_input"-->
<!--                android:padding="14dp"-->
<!--                android:layout_marginBottom="12dp" />-->

<!--            <Spinner-->
<!--                android:id="@+id/seatRowSpinner"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:background="@drawable/bg_input"-->
<!--                android:padding="14dp"-->
<!--                android:layout_marginBottom="12dp" />-->

<!--            <Spinner-->
<!--                android:id="@+id/seatCountSpinner"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:background="@drawable/bg_input"-->
<!--                android:padding="14dp" />-->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Theatre"
                style="@style/TextAppearance.NothingCinema.Meta"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/theatreSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Seat Type"
                style="@style/TextAppearance.NothingCinema.Meta"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/seatTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Seat Row"
                style="@style/TextAppearance.NothingCinema.Meta"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/seatRowSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Seat Count"
                style="@style/TextAppearance.NothingCinema.Meta"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/seatCountSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp" />
        </LinearLayout>

        <Button
            android:id="@+id/createSeatButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:text="Create Seat Row" />

    </LinearLayout>
</ScrollView>