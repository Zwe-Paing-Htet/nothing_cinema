<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:padding="18dp">

    <TextView
        android:id="@+id/reservationTypeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BOOKED"
        android:textColor="@color/nc_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/movieNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movie Name"
        android:textColor="@color/nc_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/theatreNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theatre Name"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/showtimeDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-04-06"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/showtimeTimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2:30 PM"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/bookedSeatsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A1, A2"
        style="@style/TextAppearance.NothingCinema.Body"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/totalPriceTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10000.00 MMK"
        android:textColor="@color/nc_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/bookingStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACTIVE"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/bookingTimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-04-06 10:00:00"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/bookedByTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booked by username"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/customerNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customer name"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/customerPhoneTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="09xxxxxxxxx"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/canceledAtTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Canceled at -"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/cancelBookingButton"
        style="@style/Widget.NothingCinema.Button.Danger"
        android:text="Cancel Booking" />

</LinearLayout>