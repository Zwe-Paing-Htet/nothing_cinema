<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <TextView
        android:id="@+id/paymentStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PENDING"
        android:textColor="@color/nc_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/movieNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movie Name"
        android:textColor="@color/nc_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/theatreCinemaTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theatre • Cinema"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/showtimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1/4/2026 • 2:30 PM"
        style="@style/TextAppearance.NothingCinema.BodySecondary"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/bookingInfoTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.NothingCinema.Meta"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/paymentImageView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="14dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:contentDescription="Payment Screenshot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/acceptButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Accept" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/rejectButton"
            style="@style/Widget.NothingCinema.Button.Danger"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Reject" />
    </LinearLayout>
</LinearLayout>