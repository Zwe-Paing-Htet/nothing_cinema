<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/adminTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/loggedInUserTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logged in as admin"
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="My Profile"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/logoutButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="Logout"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/themeSettingsButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="Theme Settings"
                android:layout_marginBottom="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Movies and Showtimes"
                style="@style/TextAppearance.NothingCinema.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/createMovieButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewMovieButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/createShowtimeButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewShowtimeButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cinemas and Theatres"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/createCinemaButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewCinemaButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/createTheatreButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewTheatreButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seats"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/insertSeatTypePageButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewSeatTypePageButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/createSeatPageButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/viewSeatPageButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/viewSeatStatusPageButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Users and Admins"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnViewCustomers"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/registerAdminButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnViewAdmins"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="100dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bookings and Reviews"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/viewBookingsButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />

                <Button
                    android:id="@+id/reviewBuyPaymentsButton"
                    style="@style/Widget.NothingCinema.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="start|top"
                    android:padding="16dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<com.google.android.material.bottomnavigation.BottomNavigationView
android:id="@+id/bottomNavigationView"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="24dp"
android:layout_marginEnd="24dp"
android:layout_marginBottom="30dp"
android:background="@drawable/bottom_nav_pill_background"
android:paddingTop="20dp"
app:itemActiveIndicatorStyle="@null"
app:itemBackground="@android:color/transparent"
app:itemIconSize="40dp"
app:itemIconTint="@color/bottom_nav_icon_selector"
app:labelVisibilityMode="unlabeled"
app:menu="@menu/admin_bottom_nav_menu"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>