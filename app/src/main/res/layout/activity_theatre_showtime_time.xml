<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Time"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a showtime for your selected day."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:layout_marginBottom="22dp" />

        <ImageView
            android:id="@+id/moviePosterImageView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="18dp"
            android:scaleType="fitCenter"
            android:background="@drawable/rounded_image_bg"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/ic_placeholder"
            android:contentDescription="Movie Poster" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/theatreNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theatre Name"
                android:textColor="@color/nc_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/movieNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Name"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/showtimeDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1/4/2026"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Times"
            style="@style/TextAppearance.NothingCinema.SectionTitle"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/showtimeTimeRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>