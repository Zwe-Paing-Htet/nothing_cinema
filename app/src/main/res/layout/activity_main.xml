<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Home"
                    android:textColor="@color/nc_text_secondary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/topWelcomeButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_red_circle"
                    android:contentDescription="Back to Welcome"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back_arrow"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/topProfileButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_red_circle"
                    android:contentDescription="Open Profile"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_user"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/topNotificationButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_red_circle"
                    android:contentDescription="Open Notifications"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notification"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Cinema Home"
                style="@style/TextAppearance.NothingCinema.Display" />

            <TextView
                android:id="@+id/loggedInUserTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Logged in as Guest"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />

            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Account"
                    style="@style/TextAppearance.NothingCinema.SectionTitle" />

                <Button
                    android:id="@+id/btnProfile"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_marginBottom="10dp"
                    android:text="My Profile" />

                <Button
                    android:id="@+id/notificationButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_marginBottom="10dp"
                    android:text="My Notifications"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/logoutButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_marginBottom="10dp"
                    android:text="Logout"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/backToWelcomeButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_marginBottom="10dp"
                    android:text="Back to Welcome Page"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/themeSettingsButton"
                    style="@style/Widget.NothingCinema.Button.Secondary"
                    android:layout_marginBottom="10dp"
                    android:text="Theme Settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/exploreTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Explore"
                android:visibility="gone"
                style="@style/TextAppearance.NothingCinema.SectionTitle" />

            <Button
                android:id="@+id/moviePageButton"
                style="@style/Widget.NothingCinema.Button.Primary"
                android:layout_marginBottom="12dp"
                android:text="Browse Movies"
                android:visibility="gone" />

            <Button
                android:id="@+id/cinemaPageButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:layout_marginBottom="12dp"
                android:text="Browse Cinemas"
                android:visibility="gone" />

            <Button
                android:id="@+id/searchButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="12dp"
                android:text="Search Movies"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyMoviesTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="No movies are available right now."
                android:visibility="gone"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />

            <TextView
                android:id="@+id/nowShowingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Now Showing"
                style="@style/TextAppearance.NothingCinema.SectionTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/nowShowingRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/upcomingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Upcoming"
                style="@style/TextAppearance.NothingCinema.SectionTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upcomingRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/bottom_nav_pill_background"
        android:paddingTop="20dp"
        android:paddingBottom="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@android:color/transparent"
        app:itemIconSize="40dp"
        app:itemIconTint="@color/bottom_nav_icon_selector"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>