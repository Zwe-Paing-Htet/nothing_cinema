<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seats"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage seated theatres and review individual seat records."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/viewSeatedTheatresTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seated Theatres"
            style="@style/TextAppearance.NothingCinema.SectionTitle"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/emptySeatedTheatresTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No theatres with seats found yet."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/seatedTheatresRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/seatTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seat Records"
            style="@style/TextAppearance.NothingCinema.SectionTitle"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/emptySeatsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No seats have been created yet."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/seatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>