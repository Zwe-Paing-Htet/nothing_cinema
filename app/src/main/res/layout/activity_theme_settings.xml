<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="75dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theme Mode"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the display mode that feels best for your environment."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Theme"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/systemModeRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/nc_accent_pressed"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="System Default"
                    android:textColor="@color/nc_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/lightModeRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#d71921"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Light Mode"
                    android:textColor="@color/nc_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/darkModeRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/nc_accent_pressed"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Dark Mode"
                    android:textColor="@color/nc_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />
            </RadioGroup>

        </LinearLayout>

        <Button
            android:id="@+id/applyThemeButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:textColor="#ffffff"
            android:backgroundTint="#d71921"
            android:text="Apply Theme" />

    </LinearLayout>
</ScrollView>