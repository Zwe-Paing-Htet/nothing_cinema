<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seat Status"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/showtimeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1/4/2026 • 2:30 PM"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/movieNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Name"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/theatreNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theatre Name"
                style="@style/TextAppearance.NothingCinema.Meta" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seat Legend"
            style="@style/TextAppearance.NothingCinema.SectionTitle"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_compact"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available • Dark gray"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booked • Mid gray"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bought • Blacked out"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/totalSeatsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Seats • 0"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/availableSeatsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Seats • 0"
                style="@style/TextAppearance.NothingCinema.BodySecondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/soldSeatsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sold Out Seats • 0"
                style="@style/TextAppearance.NothingCinema.BodySecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seatGridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/viewShowtimeBookingsButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:text="View Bookings For This Showtime" />

    </LinearLayout>
</ScrollView>