<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvGuestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You are browsing as guest. Please log in to view your account."
            style="@style/TextAppearance.NothingCinema.BodySecondary"
            android:visibility="gone"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/layoutProfileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profile Details"
                    style="@style/TextAppearance.NothingCinema.SectionTitle"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    style="@style/TextAppearance.NothingCinema.Body"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    style="@style/TextAppearance.NothingCinema.BodySecondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEditProfile"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnThemeSettings"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theme Settings"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDeleteAccount"
                style="@style/Widget.NothingCinema.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Account" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>