<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/nc_text_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/nc_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Movie"
            style="@style/TextAppearance.NothingCinema.Display"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Details"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/movieNameEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Movie name"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/runtimeEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Runtime in minutes"
                android:inputType="number"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/genreEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Genre"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/directorEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Director"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/castEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Cast"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/descriptionEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Description"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:gravity="top"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/trailerUrlEditText"
                style="@style/Widget.NothingCinema.EditText"
                android:hint="Trailer URL"
                android:inputType="textUri" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Release Status"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/statusRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/nowShowingRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/nc_accent_red"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Now Showing"
                    android:textColor="@color/nc_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/upcomingRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/nc_accent_red"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Upcoming"
                    android:textColor="@color/nc_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />
            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Poster"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/moviePosterImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <Button
                android:id="@+id/choosePosterButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="Choose Poster" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cover Poster"
                style="@style/TextAppearance.NothingCinema.SectionTitle"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/coverPosterImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <Button
                android:id="@+id/chooseCoverPosterButton"
                style="@style/Widget.NothingCinema.Button.Secondary"
                android:text="Choose Cover Poster" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.NothingCinema.Button.Primary"
            android:text="Save Changes" />

    </LinearLayout>
</ScrollView>