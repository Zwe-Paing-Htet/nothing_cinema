<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================
         BASE / COMPATIBILITY STYLES
         ========================= -->

    <style name="TextAppearance.NothingCinema" parent="">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.NothingCinema" parent="" />

    <style name="Widget.NothingCinema.Button" parent="">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =========================
         TEXT APPEARANCES
         ========================= -->

    <style name="TextAppearance.NothingCinema.Display" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.NothingCinema.ScreenTitle" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.NothingCinema.SectionTitle" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.NothingCinema.Body" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.NothingCinema.BodySecondary" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.NothingCinema.Meta" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.NothingCinema.Button" parent="TextAppearance.NothingCinema">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =========================
         BUTTONS
         ========================= -->

    <style name="Widget.NothingCinema.Button.Primary" parent="Widget.NothingCinema.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/nc_text_on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.NothingCinema.Button.Secondary" parent="Widget.NothingCinema.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.NothingCinema.Button.SmallSecondary" parent="Widget.NothingCinema.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.NothingCinema.Button.Danger" parent="Widget.NothingCinema.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_button_danger_outline</item>
        <item name="android:textColor">@color/nc_accent_pressed</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- =========================
         INPUTS
         ========================= -->

    <style name="Widget.NothingCinema.EditText" parent="Widget.NothingCinema">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textColorHint">@color/nc_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- =========================
         CARDS / PANELS
         ========================= -->

    <style name="Widget.NothingCinema.CardContainer" parent="Widget.NothingCinema">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Widget.NothingCinema.CardContainer.Compact" parent="Widget.NothingCinema">
        <item name="android:background">@drawable/bg_card_compact</item>
        <item name="android:padding">16dp</item>
    </style>

</resources>